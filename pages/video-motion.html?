  <link rel="stylesheet" href="../css/style.css">
  <link rel="stylesheet" href="../css/responsive.css">
  <link rel="stylesheet" href="../css/animations.css">

  <style>
    /* SERVICE PAGE STYLES */

    .service-hero {
      padding: 110px 0 85px;
      text-align: center;
      background:
        radial-gradient(
          circle at top,
          rgba(22, 131, 255, 0.15),
          transparent 65%
        ),
        var(--bg-primary);
    }

    .breadcrumb {
      margin-bottom: 25px;
      color: var(--text-secondary);
      font-size: 14px;
    }

    .breadcrumb a {
      color: var(--blue-light);
    }

    .service-hero-icon {
      font-size: 65px;
      margin-bottom: 20px;
    }

    .service-hero h1 {
      font-family: var(--font-heading);
      font-size: clamp(35px, 6vw, 65px);
      line-height: 1.15;
      margin-bottom: 25px;
    }

    .service-hero p {
      max-width: 730px;
      margin: 0 auto;
      color: var(--text-secondary);
      font-size: 17px;
    }

    .service-list-section {
      background: var(--bg-secondary);
    }

    .service-list-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 22px;
    }

    .service-item {
      padding: 28px;
      border-radius: 18px;
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      transition: var(--transition);
    }

    .service-item:hover {
      transform: translateY(-5px);
      border-color: var(--blue-primary);
    }

    .service-item-icon {
      font-size: 30px;
      margin-bottom: 15px;
    }

    .service-item h3 {
      font-family: var(--font-heading);
      font-size: 19px;
      margin-bottom: 12px;
    }

    .service-item p {
      color: var(--text-secondary);
      font-size: 14px;
      line-height: 1.8;
    }

    .service-action-section {
      background: var(--bg-primary);
    }

    .service-action-buttons {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 15px;
      margin-top: 30px;
    }

    .community-service-section {
      background: var(--bg-secondary);
    }

    @media (max-width: 900px) {
      .service-list-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 600px) {
      .service-hero {
        padding: 75px 0 60px;
      }

      .service-hero p {
        font-size: 15px;
      }

      .service-list-grid {
        grid-template-columns: 1fr;
      }

      .service-action-buttons {
        flex-direction: column;
      }

      .service-action-buttons .btn {
        width: 100%;
      }
    }
  </style>
</head>

